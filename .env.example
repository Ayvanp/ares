# Configuración de ARES (Etapa 0). Copia este archivo a .env y ajústalo.

# Base de datos. SQLite por defecto (desarrollo); Postgres en producción.
#   SQLite:    sqlite:///ares.db
#   Postgres:  postgresql+psycopg://ares:ares@localhost:5432/ares
ARES_DATABASE_URL=sqlite:///ares.db

# Token admin de arranque (bootstrap). Permite crear los primeros tokens con
# nombre vía POST /tokens. Úsalo solo para el arranque; en producción crea
# tokens nombrados con `python ares_admin.py token-crear` y deja este sin usar.
# Genera uno con:  python -c "import secrets;print('ares_'+secrets.token_urlsafe(32))"
ARES_API_TOKEN=

# Trabajadores de la cola de escaneos (hilos). 1 = FIFO serializado (robusto
# sobre SQLite). Súbelo solo con Postgres si quieres escaneos en paralelo.
ARES_TRABAJADORES=1
